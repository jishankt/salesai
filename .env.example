# Copy this file to .env and fill in real values before deploying anywhere
# other than your own machine.

MONGO_URI=mongodb://localhost:27017/
DB_NAME=sales_ai
PORT=5000
DEBUG=False

OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=30
AGENT_MAX_LOOPS=6

# Change this. Anyone with this key gets the admin dashboard + your leads/orders.
ADMIN_API_KEY=123


# "mock" (default, no real money) or "razorpay"
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=AED

# Optional: POST order events here (Slack/WhatsApp/CRM webhook, etc.)
ORDER_WEBHOOK_URL=

RATE_LIMIT_CHAT=20 per minute

# --- WhatsApp Meta API ---
# The temporary or permanent access token generated in the Meta Dashboard
META_WHATSAPP_TOKEN=EAAf4nAxdyJYBR46eK6dABIPAuhzwn5LkjEtEfkq3EJ0jLm1KXMysj7NZBZBg2xZCdqbPRvyVNmDfcQ9Oz0mfwleWU99dmi9t02wtjNmxITroDKolHtseU8oIEscQf6UZC8ZAbx0ZBbjSSpvi6iKbSsr9vst4TVyHYxKwv4EX4FBdBRUws6hv5cXPJ99g674sY14sSjreaLUWBdJUsVW7PV4ztgGsC5Po0TGvBdkNq8b1b1e00in9lu0JORbo7thYTkEpI2mR3dhHe8uWAmFBtDdwYLtwZDZD
# The Phone Number ID assigned to your test number
META_PHONE_NUMBER_ID=1243791782144336
# A secret password you make up to secure the webhook (e.g. salesai-verify-123)
META_WEBHOOK_VERIFY_TOKEN=salesai-verify-123

# --- Public base URL ---
# Full URL of your server — used to make payment links absolute and tappable in WhatsApp.
# Change to your public domain before going live (e.g. https://yourdomain.com).
BASE_URL=http://localhost:5000

# OpenAI API Key for Whisper Speech-to-Text Transcription
OPENAI_API_KEY=
